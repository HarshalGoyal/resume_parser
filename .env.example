# ==============================================================
# Resume Parser configuration
# Copy this file to .env (gitignored) and paste your keys below.
# The app reads .env automatically on startup.
# ==============================================================

# --- LLM provider API keys (paste yours; leave unused ones blank) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Bedrock uses the standard AWS credential chain instead of an API key:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# --- Default LLM selection (can be switched at runtime via POST /llm/activate) ---
# One of: anthropic | openai | google | bedrock | fake  (blank = AI endpoints disabled)
LLM_PROVIDER=
# Blank = provider default (anthropic: claude-opus-4-8, openai: gpt-4o,
# google: gemini-2.0-flash, bedrock: anthropic.claude-opus-4-8)
LLM_MODEL=

# Generic key override: if set, used for whichever provider is active,
# taking precedence over the per-provider keys above. Usually leave blank.
LLM_API_KEY=

# --- Security ---
# If set, every endpoint (except /, /health/, docs) requires this value in the
# X-API-Key request header. Blank = auth disabled (local development).
API_KEY=

# --- Storage ---
# Blank = session metadata in JSON files (default). Set a SQLAlchemy async URL
# to keep metadata in a database instead (file artifacts stay on disk):
#   sqlite:  sqlite+aiosqlite:///sessions.db
#   postgres (pip install asyncpg): postgresql+asyncpg://user:pass@host/db
DATABASE_URL=

# --- Retention ---
# Sessions older than this are deleted by the background cleanup job.
# SESSION_TIMEOUT_MINUTES=3600
# How often the cleanup job runs (0 disables it).
# CLEANUP_INTERVAL_MINUTES=60

# --- Server (read by run.py) ---
# HOST=localhost
# PORT=3030
# RELOAD=true

# --- Application settings (defaults shown; uncomment to change) ---
# STORAGE_PATH=temp_working_storage_area/session_data
# UPLOAD_MAX_SIZE=52428800
# LOG_LEVEL=INFO
# LOG_FILE=backend_app.log
# ALLOWED_HOSTS=["localhost","127.0.0.1"]
